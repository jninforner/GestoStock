import argparse
from functools import partial
from http.server import SimpleHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path


def main():
    parser = argparse.ArgumentParser(description="Engega GestoStock en local.")
    parser.add_argument("command", choices=["dev"], help="Engega el servidor local")
    parser.add_argument("--port", type=int, default=8000, help="Port del servidor")
    args = parser.parse_args()

    project = Path(__file__).resolve().parent
    handler = partial(SimpleHTTPRequestHandler, directory=str(project))
    try:
        server = ThreadingHTTPServer(("127.0.0.1", args.port), handler)
    except (OSError, OverflowError) as error:
        parser.exit(
            1,
            f"No s'ha pogut engegar GestoStock al port {args.port}: {error}\n"
            "Prova amb python3 run dev --port 8001.\n",
        )

    with server:
        print(f"Obre GestoStock a http://localhost:{server.server_port}/", flush=True)
        print("Prem Control + C per aturar el servidor.", flush=True)
        try:
            server.serve_forever()
        except KeyboardInterrupt:
            print("\nServidor aturat.")


if __name__ == "__main__":
    main()
